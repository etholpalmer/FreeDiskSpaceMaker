# DiskCleanupAdvisor is a script-only F# project: no .sln/.csproj, no build
# step. Tests run through a hand-rolled harness with dotnet fsi. The CI toolkit
# runs a non-"dotnet test" TEST_CMD verbatim, so this works on every leg.
TEST_CMD="dotnet fsi tests/Tests.fsx"

# Both legs run so the cross-platform claim (macOS | Linux | Windows in the
# README badges) is actually exercised, not just asserted. The debian leg is
# the first time these filesystem-heavy tests run on Linux.
LEGS="macos-arm64 debian-arm64"

DOTNET_VERSION=10.0
